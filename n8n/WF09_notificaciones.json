      "parameters": {
        "jsCode": "const base = $('When Executed by Another Workflow').first().json;\nconst gmail = $('Enviar Gmail').first().json;\nconst tg = $('Enviar Telegram').first().json;\nconst vinc = $('Buscar vinculación').first().json;\nconst tieneChat = !!vinc.chat_id;\n\nreturn [{\n  json: {\n    notificacion_id: 'NOT-' + Date.now(),\n    usuario_id: base.usuario_id,\n    tipo: base.tipo,\n    titulo: base.titulo,\n    mensaje: base.mensaje,\n    evento_id: base.evento_id,\n    inscripcion_id: base.inscripcion_id,\n    fecha: new Date().toISOString(),\n    gmail_estado: gmail.error ? 'ERROR' : 'ENVIADO',\n    telegram_estado: !tieneChat ? 'NO_APLICA' : (tg.error ? 'ERROR' : 'ENVIADO'),\n    gmail_error: gmail.error ? String(gmail.error).slice(0, 300) : '',\n    telegram_error: tg.error ? String(tg.error).slice(0, 300) : '',\n    clave_idempotencia: base.clave_idempotencia\n  }\n}];"
