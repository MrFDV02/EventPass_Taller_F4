    {
      "parameters": {
        "jsCode": "const f = $('Formulario crear').first().json;\nconst filas = $input.all().map(i => i.json);\n\nconst nombre = String(f.nombre || '').trim();\nconst categoria = String(f.categoria || '').trim();\nconst descripcion = String(f.descripcion || '').trim();\nconst fecha = String(f.fecha || '').trim();\nconst hora = String(f.hora || '').trim();\nconst lugar = String(f.lugar || '').trim();\nconst capacidad = Number(f.capacidad);\nconst imagen_url = String(f.imagen_url || '').trim();\nconst organizador = String(f.organizador || '').trim();\nconst estado = String(f.estado || '').trim();\n\nconst errores = [];\nif (!nombre) errores.push('nombre_requerido');\nif (!['Tecnología', 'Educación', 'Networking', 'Cultura'].includes(categoria)) errores.push('categoria_invalida');\nif (!descripcion) errores.push('descripcion_requerida');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha)) errores.push('fecha_invalida');\nif (!/^([01]\\d|2[0-3]):[0-5]\\d$/.test(hora)) errores.push('hora_invalida');\nif (!lugar) errores.push('lugar_requerido');\nif (!Number.isInteger(capacidad) || capacidad <= 0) errores.push('capacidad_invalida');\nif (!organizador) errores.push('organizador_requerido');\nif (!['BORRADOR', 'PUBLICADO'].includes(estado)) errores.push('estado_invalido');\n\nlet max = 0;\nfor (const r of filas) {\n  const m = String(r.evento_id || '').match(/^EVT-(\\d+)$/);\n  if (m) max = Math.max(max, Number(m[1]));\n}\nconst evento_id = 'EVT-' + String(max + 1).padStart(3, '0');\nconst ahora = new Date().toISOString();\n\nreturn [{ json: {\n  hay_error: errores.length > 0,\n  errores,\n  evento_id,\n  nombre,\n  categoria,\n  descripcion,\n  fecha,\n  hora,\n  lugar,\n  capacidad,\n  imagen_url,\n  organizador,\n  estado,\n  fecha_creacion: ahora,\n  fecha_actualizacion: ahora\n} }];"
      },
