    {
      "parameters": {
        "jsCode": "const id = String($('Formulario consultar').first().json.evento_id || '').trim().toUpperCase();\nconst filas = $input.all().map(i => i.json);\nconst e = filas.find(f => String(f.evento_id || '').toUpperCase() === id);\n\nif (!e) {\n  return [{ json: { mensaje: 'No existe un evento con el ID ' + id } }];\n}\n\nconst mensaje = [\n  e.evento_id + ' - ' + e.nombre,\n  'Categoría: ' + e.categoria,\n  'Fecha: ' + e.fecha + ' ' + e.hora,\n  'Lugar: ' + e.lugar,\n  'Capacidad: ' + e.capacidad,\n  'Organizador: ' + e.organizador,\n  'Estado: ' + e.estado\n].join(' | ');\n\nreturn [{ json: { mensaje } }];"
      },
