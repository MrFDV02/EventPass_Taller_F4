        "jsCode": "const f = $('Formulario actualizar').first().json;\nconst filas = $('Leer eventos actualizar').all().map(i => i.json);\nconst id = String(f.evento_id || '').trim().toUpperCase();\nconst e = filas.find(r => String(r.evento_id).trim().toUpperCase() === id);\n\nif (!e) {\n  return [{ json: { hay_error: true, errores: ['evento_no_encontrado'], evento_id: id } }];\n}\n\nconst vacio = v => v === undefined || v === null || String(v).trim() === '';\nconst val = (nuevo, actual) => vacio(nuevo) ? actual : String(nuevo).trim();\n\nconst nombre = val(f.nombre, e.nombre);\nconst categoria = val(f.categoria, e.categoria);\nconst descripcion = val(f.descripcion, e.descripcion);\nconst fecha = val(f.fecha, e.fecha);\nconst hora = val(f.hora, e.hora);\nconst lugar = val(f.lugar, e.lugar);\nconst capacidad = (vacio(f.capacidad) || Number(f.capacidad) === 0) ? Number(e.capacidad) : Number(f.capacidad);\nconst imagen_url = val(f.imagen_url, e.imagen_url);\nconst organizador = val(f.organizador, e.organizador);\nconst estado = val(f.estado, e.estado);\n\nconst errores = [];\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha)) errores.push('fecha_invalida');\nif (!/^([01]?\\d|2[0-3]):[0-5]\\d$/.test(hora)) errores.push('hora_invalida');\nif (!Number.isInteger(capacidad) || capacidad <= 0) errores.push('capacidad_invalida');\nif (!['BORRADOR', 'PUBLICADO', 'CERRADO'].includes(estado) && estado !== e.estado) errores.push('estado_invalido');\n\nreturn [{ json: {\n  hay_error: errores.length > 0,\n  errores,\n  evento_id: e.evento_id,\n  nombre,\n  categoria,\n  descripcion,\n  fecha,\n  hora,\n  lugar,\n  capacidad,\n  imagen_url,\n  organizador,\n  estado,\n  fecha_actualizacion: new Date().toISOString()\n} }];"
      },
