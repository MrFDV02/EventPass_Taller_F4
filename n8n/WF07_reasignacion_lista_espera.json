    {
      "parameters": {
        "jsCode": "const eventos = $('Leer eventos').all().map(i => i.json).filter(e => e.evento_id);\nconst ins = $input.all().map(i => i.json).filter(r => r.inscripcion_id);\n\nconst promociones = [];\n\nfor (const ev of eventos) {\n  const delEvento = ins.filter(r => r.evento_id === ev.evento_id);\n  const confirmadas = delEvento.filter(r => r.estado === 'CONFIRMADA').length;\n  const cupos = Number(ev.capacidad) - confirmadas;\n  if (cupos <= 0) continue;\n\n  const espera = delEvento\n    .filter(r => r.estado === 'LISTA_ESPERA')\n    .sort((a, b) => new Date(a.fecha_inscripcion) - new Date(b.fecha_inscripcion))\n    .slice(0, cupos);\n\n  espera.forEach((r, idx) => {\n    promociones.push({ json: {\n      evento_id: ev.evento_id,\n      inscripcion_id: r.inscripcion_id,\n      usuario_id: r.usuario_id,\n      orden_lista: idx + 1,\n      estado_anterior: 'LISTA_ESPERA',\n      estado_nuevo: 'CONFIRMADA'\n    }});\n  });\n}\n\nreturn promociones;"
      },
