    {
      "parameters": {
        "jsCode": "const VENTANA_HORAS = 24;\nconst TIPO = 'RECORDATORIO_24H';\nconst ahora = new Date();\n\nconst eventos = $('Leer eventos').all().map(i => i.json);\nconst ins = $('Leer inscripciones').all().map(i => i.json).filter(r => r.inscripcion_id);\nconst previos = $('Leer recordatorios').all().map(i => i.json);\nconst enviados = new Set(previos.map(r => r.clave_idempotencia).filter(Boolean));\n\nconst salida = [];\nfor (const ev of eventos) {\n  if (!ev.evento_id || !ev.fecha) continue;\n  const hora = String(ev.hora || '00:00').slice(0, 5);\n  const inicio = new Date(`${ev.fecha}T${hora}:00-05:00`);\n  const horasFaltan = (inicio - ahora) / 3600000;\n  if (horasFaltan <= 0 || horasFaltan > VENTANA_HORAS) continue;\n\n  for (const r of ins.filter(x => x.evento_id === ev.evento_id && x.estado === 'CONFIRMADA')) {\n    const clave = `${r.usuario_id}_${ev.evento_id}_${TIPO}`;\n    if (enviados.has(clave)) continue;\n    salida.push({ json: {\n      recordatorio_id: 'REC-' + Date.now() + '-' + salida.length,\n      usuario_id: r.usuario_id,\n      evento_id: ev.evento_id,\n      inscripcion_id: r.inscripcion_id,\n      tipo_recordatorio: TIPO,\n      fecha_programada: inicio.toISOString(),\n      fecha_envio: '',\n      estado: 'PENDIENTE',\n      clave_idempotencia: clave,\n      nombre_evento: ev.nombre,\n      fecha_evento: ev.fecha,\n      hora_evento: hora,\n      lugar: ev.lugar\n    }});\n  }\n}\nreturn salida;;"
      },
