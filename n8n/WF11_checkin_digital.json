    {
      "parameters": {
        "jsCode": "const req = $('Webhook Checkin').first().json.body || {};\nconst inscId = String(req.inscripcion_id || '').trim();\nconst evId = String(req.evento_id || '').trim().toUpperCase();\n\nconst insc = $('Leer inscripción').first().json;\nconst ev = $('Leer evento').first().json;\nconst previos = $('Leer checkins').all().map(i => i.json).filter(r => r.checkin_id);\n\nconst existeInsc = !!insc.inscripcion_id && String(insc.inscripcion_id).trim() === inscId;\nconst existeEv = !!ev.evento_id && String(ev.evento_id).trim().toUpperCase() === evId;\nconst estado = String(insc.estado || '').trim().toUpperCase();\nconst yaIngreso = previos.some(r => String(r.resultado).trim().toUpperCase() === 'EXITOSO');\n\nlet resultado = 'EXITOSO';\nlet detalle = 'Check-in realizado correctamente.';\n\nif (!inscId || !evId) {\n  resultado = 'RECHAZADO'; detalle = 'Faltan datos: se requiere inscripcion_id y evento_id.';\n} else if (!existeInsc) {\n  resultado = 'RECHAZADO'; detalle = 'La inscripción no existe.';\n} else if (!existeEv) {\n  resultado = 'RECHAZADO'; detalle = 'El evento no existe.';\n} else if (String(insc.evento_id).trim().toUpperCase() !== evId) {\n  resultado = 'RECHAZADO'; detalle = 'La inscripción pertenece a otro evento.';\n} else if (yaIngreso || estado === 'ASISTIO') {\n  resultado = 'DUPLICADO'; detalle = 'El ingreso ya había sido registrado.';\n} else if (estado !== 'CONFIRMADA') {\n  resultado = 'RECHAZADO'; detalle = 'La inscripción no permite asistencia (estado: ' + (estado || 'desconocido') + ').';\n}\n\nreturn [{\n  json: {\n    checkin_id: 'CHK-' + Date.now(),\n    inscripcion_id: inscId,\n    evento_id: evId,\n    usuario_id: existeInsc ? insc.usuario_id : '',\n    fecha_checkin: new Date().toISOString(),\n    resultado,\n    detalle\n  }\n}];"
      },
