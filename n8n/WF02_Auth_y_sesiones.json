      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst operacion = String(body.operacion || '').trim().toLowerCase();\nconst email = String(body.email || '').trim().toLowerCase();\nconst password = String(body.password || '');\nconst session_token = String(body.session_token || '').trim();\n\nconst errores = [];\nif (!['login', 'logout', 'validar'].includes(operacion)) {\n  errores.push('operacion invalida (login, logout o validar)');\n}\nif (operacion === 'login') {\n  if (!email) errores.push('email es obligatorio');\n  if (!password) errores.push('password es obligatorio');\n}\nif (['logout', 'validar'].includes(operacion) && !session_token) {\n  errores.push('session_token es obligatorio');\n}\n\nreturn [{ json: { operacion, email, password, session_token, errores, hay_error: errores.length > 0 } }];"
      },
