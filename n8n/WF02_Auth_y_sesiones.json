      "parameters": {
        "jsCode": "const token = $('Validar y normalizar').first().json.session_token;\nconst filas = $input.all().map(i => i.json);\nconst s = filas.find(f => f.session_token === token);\n\nif (!s) {\n  return [{ json: { valida: false, motivo: 'sesion_no_existe' } }];\n}\nif (s.estado === 'CERRADA') {\n  return [{ json: { valida: false, motivo: 'sesion_cerrada', session_id: s.session_id } }];\n}\nif (s.estado === 'EXPIRADA' || new Date(s.expira_en) <= new Date()) {\n  return [{ json: {\n    valida: false,\n    motivo: 'sesion_expirada',\n    session_id: s.session_id,\n    usuario_id: s.usuario_id,\n    marcar_expirada: s.estado !== 'EXPIRADA'\n  } }];\n}\nreturn [{ json: {\n  valida: true,\n  motivo: '',\n  session_id: s.session_id,\n  usuario_id: s.usuario_id,\n  expira_en: s.expira_en\n} }];"
