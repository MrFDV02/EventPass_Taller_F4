    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst entrada = $('Validar y normalizar').first().json;\nconst filas = $input.all().map(i => i.json);\n\nconst u = filas.find(f => String(f.email_normalizado || '').toLowerCase() === entrada.email);\n\nlet motivo = null;\nlet login_ok = false;\n\nif (!u) {\n  motivo = 'credenciales_invalidas';\n} else if (String(u.estado).toUpperCase() !== 'ACTIVO') {\n  motivo = 'usuario_inactivo';\n} else {\n  const hash = crypto.pbkdf2Sync(String(entrada.password), String(u.password_salt), 100000, 64, 'sha512').toString('hex');\n  const a = Buffer.from(hash, 'hex');\n  const b = Buffer.from(String(u.password_hash), 'hex');\n  login_ok = a.length === b.length && crypto.timingSafeEqual(a, b);\n  if (!login_ok) motivo = 'credenciales_invalidas';\n}\n\nreturn [{ json: {\n  login_ok,\n  motivo,\n  usuario_id: u ? u.usuario_id : null,\n  nombre: u ? u.nombre : null,\n  email: entrada.email\n}}];"
      },
