        "jsCode": "const crypto = require('crypto');\nconst d = $input.first().json;\n\nlet hash = d.usuario_actual.password_hash;\nlet salt = d.usuario_actual.password_salt;\n\nif (d.password) {\n  salt = crypto.randomBytes(16).toString('hex');\n  hash = crypto.pbkdf2Sync(String(d.password), salt, 100000, 64, 'sha512').toString('hex');\n}\n\nreturn [{ json: {\n  ...d,\n  password: null,\n  password_hash: hash,\n  password_salt: salt\n}}];"
      },
