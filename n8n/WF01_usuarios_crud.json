    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst op = String(b.operacion || '').toLowerCase().trim();\nconst email = String(b.email || '').toLowerCase().trim();\nconst out = { operacion: op, error: null, status: 200 };\n\nconst ops = ['crear', 'perfil', 'actualizar', 'desactivar'];\nif (!ops.includes(op)) {\n  out.error = 'operacion invalida'; out.status = 400;\n} else if (op === 'crear') {\n  if (!b.nombre || !email || !b.password) { out.error = 'nombre, email y password son obligatorios'; out.status = 400; }\n  else if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) { out.error = 'email invalido'; out.status = 400; }\n  else if (String(b.password).length < 8) { out.error = 'password minimo 8 caracteres'; out.status = 400; }\n} else if (!b.usuario_id) {\n  out.error = 'usuario_id es obligatorio'; out.status = 400;\n} else if (!b.session_token) {\n  out.error = 'sesion requerida'; out.status = 401;\n} else if (op === 'actualizar' && !b.nombre) {\n  out.error = 'nombre es obligatorio'; out.status = 400;\n}\n\nreturn [{ json: {\n  ...out,\n  nombre: b.nombre ? String(b.nombre).trim() : null,\n  email_normalizado: email || null,\n  password: b.password || null,\n  usuario_id: b.usuario_id || null,\n  session_token: b.session_token || null\n}}];"
      },
