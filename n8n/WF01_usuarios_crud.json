    {
      "parameters": {
        "jsCode": "const datos = $('Validar y normalizar').first().json;\nconst filas = $('Leer usuarios').all().map(i => i.json).filter(r => r.usuario_id);\nconst sesiones = $('Leer sesiones').all().map(i => i.json).filter(r => r.session_token);\n\nlet error = datos.error;\nlet status = datos.status;\n\nif (!error && datos.operacion !== 'crear') {\n  const s = sesiones.find(r => r.session_token === datos.session_token);\n  const vigente = s && String(s.estado).toUpperCase() === 'ACTIVA' && new Date(s.expira_en).getTime() > Date.now();\n  if (!vigente || s.usuario_id !== datos.usuario_id) {\n    error = 'sesion invalida o expirada';\n    status = 401;\n  }\n}\n\nlet usuario = null;\nif (datos.operacion === 'crear') {\n  usuario = filas.find(r => r.email_normalizado === datos.email_normalizado) || null;\n} else if (datos.usuario_id) {\n  usuario = filas.find(r => r.usuario_id === datos.usuario_id) || null;\n}\n\nconst max = filas.reduce((m, r) => Math.max(m, parseInt(String(r.usuario_id).split('-')[1], 10) || 0), 0);\nconst nuevoId = 'USR-' + String(max + 1).padStart(4, '0');\n\nreturn [{ json: {\n  ...datos,\n  error,\n  status,\n  existe: !!usuario,\n  usuario_actual: usuario,\n  nuevo_usuario_id: nuevoId,\n  ahora: new Date().toISOString()\n}}];"
      },
