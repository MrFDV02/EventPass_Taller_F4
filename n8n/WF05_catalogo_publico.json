    {
      "parameters": {
        "jsCode": "const q = $('Validar consulta').first().json;\nconst eventos = $('Leer eventos').all().map(i => i.json).filter(r => r.evento_id);\nconst inscripciones = $('Leer inscripciones').all().map(i => i.json).filter(r => r.inscripcion_id);\n\nif (q.error) {\n  return [{ json: { ...q, resultado_count: 0, respuesta: { ok: false, error: q.error } } }];\n}\n\nconst norm = s => String(s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim().toLowerCase();\n\n// Cupos = capacidad - inscripciones CONFIRMADAS\nconst confirmadas = {};\nfor (const i of inscripciones) {\n  if (String(i.estado).trim().toUpperCase() === 'CONFIRMADA') {\n    const id = String(i.evento_id).trim().toUpperCase();\n    confirmadas[id] = (confirmadas[id] || 0) + 1;\n  }\n}\n\nconst armar = e => {\n  const id = String(e.evento_id).trim().toUpperCase();\n  const capacidad = Number(e.capacidad) || 0;\n  const ocupados = confirmadas[id] || 0;\n  const cupos = Math.max(capacidad - ocupados, 0);\n  return {\n    evento_id: id,\n    nombre: e.nombre,\n    categoria: e.categoria,\n    descripcion: e.descripcion,\n    fecha: e.fecha,\n    hora: e.hora,\n    lugar: e.lugar,\n    capacidad,\n    imagen_url: e.imagen_url || '',\n    organizador: e.organizador,\n    estado: e.estado,\n    inscritos_confirmados: ocupados,\n    cupos_disponibles: cupos,\n    disponibilidad: cupos > 0 ? 'CON_CUPOS' : 'LLENO'\n  };\n};\n\n// Solo eventos publicables\nconst publicados = eventos.filter(e => String(e.estado).trim().toUpperCase() === 'PUBLICADO');\n\nlet status = 200;\nlet resultado_count = 0;\nlet respuesta;\n\nif (q.tipo === 'DETALLE') {\n  const e = publicados.find(x => String(x.evento_id).trim().toUpperCase() === q.evento_id);\n  if (!e) {\n    status = 404;\n    respuesta = { ok: false, error: 'Evento no encontrado' };\n  } else {\n    resultado_count = 1;\n    respuesta = { ok: true, data: armar(e) };\n  }\n} else {\n  let lista = publicados;\n  if (q.tipo === 'FILTRO') {\n    lista = publicados.filter(e => norm(e.categoria) === norm(q.categoria));\n  }\n  const data = lista.map(armar);\n  resultado_count = data.length;\n  respuesta = { ok: true, total: data.length, data };\n}\n\nreturn [{ json: { ...q, status, resultado_count, respuesta } }];"
      },
