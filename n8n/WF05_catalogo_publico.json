      "name": "Leer inscripciones",
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "pneOzUi3j5Q3tjgS",
          "name": "Google Sheets account"
        }
      }
