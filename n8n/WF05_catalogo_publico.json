    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst vacio = v => v === undefined || v === null || String(v).trim() === '';\n\nconst evento_id = vacio(b.evento_id) ? null : String(b.evento_id).trim().toUpperCase();\nconst categoria = vacio(b.categoria) ? null : String(b.categoria).trim();\nconst visitor_id = vacio(b.visitor_id) ? 'anonimo' : String(b.visitor_id).trim();\n\nlet tipo = vacio(b.tipo) ? null : String(b.tipo).trim().toUpperCase();\nif (!tipo) tipo = evento_id ? 'DETALLE' : (categoria ? 'FILTRO' : 'LISTADO');\n\nlet error = null;\nlet status = 200;\nif (!['LISTADO', 'DETALLE', 'FILTRO'].includes(tipo)) {\n  error = 'tipo invalido (usa LISTADO, DETALLE o FILTRO)'; status = 400;\n} else if (tipo === 'DETALLE' && !evento_id) {\n  error = 'evento_id es obligatorio para DETALLE'; status = 400;\n} else if (tipo === 'FILTRO' && !categoria) {\n  error = 'categoria es obligatoria para FILTRO'; status = 400;\n}\n\nreturn [{ json: {\n  tipo, evento_id, categoria, visitor_id, error, status,\n  consulta_id: 'CON-' + Date.now(),\n  ahora: new Date().toISOString()\n} }];"
      },
