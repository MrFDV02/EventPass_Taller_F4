      "parameters": {
        "jsCode": "const dato = $('Extraer código').first().json;\nconst filas = $input.all().map(i => i.json);\nconst c = filas.find(f => String(f.codigo || '').toUpperCase() === dato.codigo);\n\nconst base = { chat_id: dato.chat_id, telegram_username: dato.telegram_username, codigo: dato.codigo };\n\nif (!c) {\n  return [{ json: { ...base, codigo_ok: false, motivo: 'codigo_no_existe' } }];\n}\nif (c.estado === 'USADO') {\n  return [{ json: { ...base, codigo_ok: false, motivo: 'codigo_usado' } }];\n}\nif (c.estado === 'CANCELADO') {\n  return [{ json: { ...base, codigo_ok: false, motivo: 'codigo_cancelado' } }];\n}\nif (c.estado === 'EXPIRADO' || new Date(c.expira_en) <= new Date()) {\n  return [{ json: { ...base, codigo_ok: false, motivo: 'codigo_expirado' } }];\n}\nreturn [{ json: {\n  ...base,\n  codigo_ok: true,\n  motivo: '',\n  codigo_id: c.codigo_id,\n  usuario_id: c.usuario_id\n} }];"
