        "jsCode": "const msg = $input.first().json.message || {};\nconst texto = (msg.text || '').trim();\nconst partes = texto.split(/\\s+/);\nconst esVincular = partes[0].toLowerCase() === '/vincular';\nconst codigo = esVincular && partes[1] ? partes[1].toUpperCase() : '';\n\nreturn [{ json: {\n  es_vincular: esVincular && codigo !== '',\n  codigo,\n  chat_id: String(msg.chat?.id || ''),\n  telegram_username: msg.from?.username || ''\n} }];"
