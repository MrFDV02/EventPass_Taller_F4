        "jsCode": "const body = $('Webhook Solicitar código').first().json.body || {};\nconst token = String(body.session_token || '').trim();\nconst filas = $input.all().map(i => i.json);\nconst s = token ? filas.find(f => f.session_token === token) : null;\n\nif (!token) {\n  return [{ json: { sesion_ok: false, motivo: 'session_token_requerido' } }];\n}\nif (!s) {\n  return [{ json: { sesion_ok: false, motivo: 'sesion_no_existe' } }];\n}\nif (s.estado === 'CERRADA') {\n  return [{ json: { sesion_ok: false, motivo: 'sesion_cerrada' } }];\n}\nif (s.estado === 'EXPIRADA' || new Date(s.expira_en) <= new Date()) {\n  return [{ json: { sesion_ok: false, motivo: 'sesion_expirada' } }];\n}\nreturn [{ json: { sesion_ok: true, motivo: '', usuario_id: s.usuario_id } }];"
